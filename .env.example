# ──────────────────────────────────────────────────────────────
# Supabase  (Project Settings → API)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by the Server Action to insert orders, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ──────────────────────────────────────────────────────────────
# Meta / Facebook Pixel + Conversions API
# ──────────────────────────────────────────────────────────────
# Public — exposed to the browser pixel.
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
# Server-only — Conversions API (Events Manager → Settings → Generate access token)
META_CAPI_ACCESS_TOKEN=your-capi-access-token
# Optional: only set while testing in Events Manager → Test Events.
META_CAPI_TEST_EVENT_CODE=

# ──────────────────────────────────────────────────────────────
# Admin dashboard (/dashboard)
# ──────────────────────────────────────────────────────────────
# Single shared login password for the orders dashboard. Use a strong value.
DASHBOARD_PASSWORD=

# ──────────────────────────────────────────────────────────────
# Store / contact
# ──────────────────────────────────────────────────────────────
# International format, digits only (e.g. 213xxxxxxxxx for Algeria).
NEXT_PUBLIC_WHATSAPP_NUMBER=213000000000
NEXT_PUBLIC_SITE_URL=https://your-domain.com
